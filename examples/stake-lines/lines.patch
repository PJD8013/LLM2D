diff --git a/apps/lines/src/components/SymbolLlm2d.svelte b/apps/lines/src/components/SymbolLlm2d.svelte
new file mode 100644
index 0000000..0378a0d
--- /dev/null
+++ b/apps/lines/src/components/SymbolLlm2d.svelte
@@ -0,0 +1,50 @@
+<script lang="ts">
+	import { SpineProvider, SpineTrack } from 'pixi-svelte';
+	import { Llm2dProvider, Llm2dTrack } from '@llm2d/svelte';
+	import { stateBetDerived } from 'state-shared';
+
+	import { SYMBOL_SIZE } from '../game/constants';
+
+	type Props = {
+		symbolInfo: {
+			assetKey: string;
+			animationName?: string;
+			sizeRatios: { width: number; height: number };
+		};
+		x?: number;
+		y?: number;
+		loop?: boolean;
+		showWinFrame?: boolean;
+		oncomplete?: () => void;
+	};
+
+	const props: Props = $props();
+	// idle loops on its own; land and win play once and report `complete` (unless the caller sets loop).
+	const animationName = $derived(props.symbolInfo.animationName ?? 'idle');
+</script>
+
+<!-- Same slot as SymbolSpineMain: centred on (x, y), fitted to the cell, sped up with turbo. -->
+<Llm2dProvider
+	x={props.x}
+	y={props.y}
+	anchor={0.5}
+	key={props.symbolInfo.assetKey}
+	width={SYMBOL_SIZE * props.symbolInfo.sizeRatios.width}
+	height={SYMBOL_SIZE * props.symbolInfo.sizeRatios.height}
+>
+	<Llm2dTrack
+		trackIndex={0}
+		{animationName}
+		loop={props.loop ?? animationName === 'idle'}
+		mix={0.1}
+		timeScale={stateBetDerived.timeScale()}
+		listener={{ complete: () => props.oncomplete?.() }}
+	/>
+</Llm2dProvider>
+
+<!-- tumble frame, as in SymbolSpine -->
+{#if props.showWinFrame}
+	<SpineProvider x={props.x} y={props.y} key="anticipation" width={SYMBOL_SIZE * 0.19}>
+		<SpineTrack trackIndex={0} animationName={'payframe'} loop />
+	</SpineProvider>
+{/if}
