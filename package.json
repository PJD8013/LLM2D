{
  "name": "llm2d-workspace",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @llm2d/viewer dev",
    "build:viewer": "pnpm --filter @llm2d/viewer build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @llm2d/svelte --filter @llm2d/reel-demo check",
    "samples": "node scripts/build-samples.ts",
    "validate": "node scripts/validate.ts",
    "render": "node scripts/render.ts",
    "rig": "node scripts/rig.ts",
    "split": "node scripts/split.ts",
    "mcp": "node packages/mcp/src/server.ts",
    "mcp:call": "node scripts/mcp-call.ts",
    "export": "node scripts/export.ts",
    "pack:lib": "node scripts/pack-lib.ts",
    "stake:lines": "node scripts/stake-lines.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "3.2.7",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "pnpm": {
    "overrides": {
      "@esotericsoftware/spine-core": "4.2.74",
      "@esotericsoftware/spine-pixi-v8": "4.2.74",
      "pixi-filters": "6.1.0",
      "vite": "6.4.5"
    }
  }
}
