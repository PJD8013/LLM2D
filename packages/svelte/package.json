{
  "name": "@llm2d/svelte",
  "version": "0.1.0",
  "description": "Svelte 5 components for LLM2D skeletons in pixi-svelte (Stake Engine web SDK).",
  "type": "module",
  "license": "UNLICENSED",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    }
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "svelte-package -i src/lib -o dist"
  },
  "dependencies": {
    "@llm2d/core": "workspace:*",
    "@llm2d/pixi": "workspace:*"
  },
  "peerDependencies": {
    "pixi-svelte": "^2.1.0",
    "pixi.js": "^8.8.0",
    "svelte": "^5.20.0"
  },
  "devDependencies": {
    "@sveltejs/package": "2.3.10",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "pixi-svelte": "2.1.0",
    "pixi.js": "8.8.1",
    "svelte": "5.20.5",
    "svelte-check": "4.1.5",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  }
}
